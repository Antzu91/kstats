<?xml version="1.0" encoding="UTF-8"?>
<kcfg
    xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="" />
    <group name="General">
        <entry name="updateRateLimit" type="Int">
            <default>1000</default>
        </entry>
        <entry name="historyWindowMinutes" type="Int">
            <default>1</default>
        </entry>
        <entry name="compactBarLength" type="Int">
            <default>0</default>
        </entry>
        <!-- Module IDs, comma separated; unknown or duplicate IDs are ignored and missing ones appended. -->
        <entry name="moduleOrder" type="String">
            <default>cpu,memory,gpu,disk,network</default>
        </entry>
        <entry name="showCpu" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showMemory" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showGpu" type="Bool">
            <default>false</default>
        </entry>
        <entry name="gpuDeviceId" type="String">
            <default>gpu0</default>
        </entry>
        <entry name="showDisk" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showNetwork" type="Bool">
            <default>true</default>
        </entry>
        <!-- Panel presentation per module: number, graph, numberGraph or bar;
             network: numbers, graph or numbersGraph. Unknown values use the default. -->
        <entry name="cpuPresentation" type="String">
            <default>numberGraph</default>
        </entry>
        <entry name="cpuShowLabel" type="Bool">
            <default>true</default>
        </entry>
        <entry name="memoryPresentation" type="String">
            <default>numberGraph</default>
        </entry>
        <entry name="memoryShowLabel" type="Bool">
            <default>true</default>
        </entry>
        <entry name="gpuPresentation" type="String">
            <default>numberGraph</default>
        </entry>
        <entry name="gpuShowLabel" type="Bool">
            <default>true</default>
        </entry>
        <entry name="diskPresentation" type="String">
            <default>bar</default>
        </entry>
        <entry name="diskShowLabel" type="Bool">
            <default>true</default>
        </entry>
        <entry name="networkPresentation" type="String">
            <default>numbers</default>
        </entry>
        <entry name="networkShowLabel" type="Bool">
            <default>true</default>
        </entry>
        <!-- comfortable or compact -->
        <entry name="popupDensity" type="String">
            <default>comfortable</default>
        </entry>
        <!-- Remembered section expansion, e.g. "ram.details=0,cpu.apps=1". -->
        <entry name="sectionStates" type="String">
            <default></default>
        </entry>
        <entry name="monochrome" type="Bool">
            <default>false</default>
        </entry>
        <entry name="barLabelFontSize" type="Int">
            <default>0</default>
        </entry>
        <entry name="barValueFontSize" type="Int">
            <default>0</default>
        </entry>
        <entry name="cpuSensorId" type="String">
            <default>cpu/all/usage</default>
        </entry>
        <!-- auto, off, or a sensor ID chosen in settings. -->
        <entry name="cpuTemperatureSensor" type="String">
            <default>auto</default>
        </entry>
        <entry name="cpuFanSensor" type="String">
            <default>auto</default>
        </entry>
        <entry name="memorySensorId" type="String">
            <default>memory/physical/usedPercent</default>
        </entry>
        <!-- all, volume:ID or custom; custom uses the three disk sensor IDs below. -->
        <entry name="diskSource" type="String">
            <default>all</default>
        </entry>
        <entry name="diskSensorId" type="String">
            <default>disk/all/usedPercent</default>
        </entry>
        <entry name="diskReadSensorId" type="String">
            <default>disk/all/read</default>
        </entry>
        <entry name="diskWriteSensorId" type="String">
            <default>disk/all/write</default>
        </entry>
        <!-- all, auto, interface:NAME or custom; custom uses the two sensor IDs below. -->
        <entry name="networkSource" type="String">
            <default>all</default>
        </entry>
        <!-- Opt-in: contacts api64.ipify.org when the Network page opens or on refresh. -->
        <entry name="publicIpLookup" type="Bool">
            <default>false</default>
        </entry>
        <entry name="networkDownloadSensorId" type="String">
            <default>network/all/download</default>
        </entry>
        <entry name="networkUploadSensorId" type="String">
            <default>network/all/upload</default>
        </entry>
    </group>
</kcfg>
